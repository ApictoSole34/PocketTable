<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:alpha="0.9"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTopCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Top: "
                android:textSize="18sp"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvDrawPile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Draw: 0"
                android:textSize="18sp"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llOpponents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvTurnInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waiting for players..."
            android:textSize="20sp"
            android:textColor="#FFD700"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgTopCard"
                android:layout_width="96dp"
                android:layout_height="134dp"
                android:src="@drawable/card_back"
                android:scaleType="fitCenter"/>

            <ImageView
                android:id="@+id/imgDrawPile"
                android:layout_width="96dp"
                android:layout_height="134dp"
                android:src="@drawable/card_back"
                android:scaleType="fitCenter"
                android:layout_marginStart="24dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your hand"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHand"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnDraw"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="DRAW"
                android:layout_margin="4dp"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnLastCard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="LAST CARD!"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnNextRound"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="NEXT ROUND"
                android:layout_margin="4dp"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>