<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_mafia_player_item"
    android:layout_margin="4dp"
    android:padding="8dp"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icon_circle"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/ivRoleIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/icon_mafia_civilian"
            android:contentDescription="@string/role_icon_desc"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvPlayerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:paddingTop="2dp"
        android:shadowColor="#000000"
        android:shadowRadius="2"
        android:shadowDx="0"
        android:shadowDy="1"
        android:background="#80000000"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"    />

    <TextView
        android:id="@+id/tvPlayerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF6B6B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingTop="2dp"
        android:shadowColor="#000000"
        android:shadowRadius="2"
        android:shadowDx="0"
        android:shadowDy="1"/>

    <TextView
        android:id="@+id/tvVotedBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_vote_badge"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginTop="4dp"/>
</LinearLayout>