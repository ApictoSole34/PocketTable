<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:padding="8dp"
            android:shadowColor="#000000"
            android:shadowRadius="3"
            android:shadowDx="0"
            android:shadowDy="2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPhase"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/mafia_phase_label_short"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:paddingTop="4dp"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="1"/>

            <Button
                android:id="@+id/btnRoleInfo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/mafia_role_info_button"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@drawable/btn_mafia_rounded"/>

            <Button
                android:id="@+id/btnNotes"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/mafia_notes_button"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/btn_mafia_rounded"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mafia_your_role_label_short"
            android:textSize="16sp"
            android:textColor="@color/gold"
            android:paddingTop="2dp"
            android:shadowColor="#000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="1"/>

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/gray"
            android:paddingTop="4dp"
            android:shadowColor="#000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="1"/>

        <LinearLayout
            android:id="@+id/candidatePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            android:background="#AA000000"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvCandidateName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mafia_candidate_label"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btnGuilty"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/button_mafia_guilty"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/mafia_guilty_content_desc"/>

                    <TextView
                        android:id="@+id/tvGuiltyCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:paddingTop="4dp"
                        android:shadowColor="#000000"
                        android:shadowRadius="2"
                        android:shadowDx="0"
                        android:shadowDy="1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="8dp">

                    <ImageButton
                        android:id="@+id/btnNotGuilty"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/button_mafia_notguilty"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/mafia_not_guilty_content_desc"/>

                    <TextView
                        android:id="@+id/tvNotGuiltyCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:paddingTop="4dp"
                        android:shadowColor="#000000"
                        android:shadowRadius="2"
                        android:shadowDx="0"
                        android:shadowDy="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlayers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnSkip"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/mafia_skip"
                android:background="@drawable/btn_mafia_rounded"
                android:textColor="@color/white"
                android:layout_marginEnd="4dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>