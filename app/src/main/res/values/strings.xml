    <!-- Connection problem dialog -->
    <string name="diagnostics_button">⚠️ Connection issues?</string>
    <string name="diagnostics_title">Background restrictions</string>
    <string name="diagnostics_tips_full">Some devices aggressively restrict background apps
                                        (Xiaomi, Oppo, Realme, Huawei, Vivo, and others may kill PocketTable in the
                                        background, causing disconnections during gameplay).\n\nFix:\n
                                            1. Go to Settings → Battery → App battery management\n
                                            2. Find PocketTable\n
                                            3. Select \"Don\'t optimize\" or \"Allow background activity\"\n\n
                                        On Xiaomi (MIUI): also enable \"Autostart\" for PocketTable in Settings → Apps → Manage apps.\n
                                        On Oppo/Realme (ColorOS): Settings → Battery → App Battery Management → PocketTable → Allow background activity.\n
                                        On Huawei (EMUI): Settings → Battery → App launch → PocketTable → set to Manage manually, enable all 3 toggles.\n
                                        On Vivo (FuntouchOS): Settings → Battery → Background power consumption management → allow PocketTable.</string>
    <string name="diagnostics_battery_button">Open battery settings</string>
