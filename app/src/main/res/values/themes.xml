<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PocketTable" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.PocketTable" parent="Base.Theme.PocketTable">
        <item name="colorPrimary">@color/button_background</item>
        <item name="colorPrimaryVariant">@color/button_background</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="AppAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/dialog_background</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="colorAccent">@color/gold</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/gold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>